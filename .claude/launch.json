{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "istanbul72-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "run",
        "dev"
      ],
      "port": 5272,
      "autoPort": true
    },
    {
      "name": "istanbul72-dist",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd web && npx vite preview --port 5273 --strictPort"
      ],
      "port": 5273
    }
  ]
}